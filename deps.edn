{:paths ["src"]
 ;; langgraph powers the explorer.operation StateGraph and brings langchain
 ;; transitively (langchain.model is the advisor seam). Both live in the
 ;; kotoba-lang org of this workspace and are all-.cljc / portable
 ;; (kotoba wasm -> clojurewasm -> ClojureScript -> nbb runtime priority,
 ;; AGENTS.md). These :local/root paths resolve inside the monorepo
 ;; checkout; a standalone fork overrides them with git coordinates.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchain"}}}
  ;; kbb -M:dev:run -> drive the offline 9-operation demo
  :run {:main-opts ["-m" "explorer.sim"]}
  ;; kbb -M:dev:render-html -> build docs/samples/operator-console.html
  :render-html {:main-opts ["-m" "explorer.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Live multi-endpoint chain reads. HERE and not in :deps or :test on
  ;; purpose: only explorer.rpc needs org-ethereum-jsonrpc, nothing under
  ;; test/ requires that namespace, and CI's offline `kbb -M:dev:test`
  ;; job checks out only langgraph/langchain -- so the test path must not
  ;; depend on a third sibling checkout. Everything worth testing about
  ;; chain semantics is pure and lives in explorer.chain, which has no
  ;; external dependency at all.
  ;;   ETH_RPC_URLS=https://a,https://b kbb -M:rpc:dev:run-rpc
  :rpc {:extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}
                     metosin/jsonista {:mvn/version "0.3.11"}
                     io.github.kotoba-lang/org-ethereum-jsonrpc
        {:local/root "../../kotoba-lang/kotoba/lib/org.ethereum.jsonrpc"}}}
  :run-rpc {:main-opts ["-m" "explorer.rpc-demo"]}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main"
                     "--lint" "src" "test"
                     "--fail-level" "error"]}}}
